{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookmark-rota.local/schemas/bookmarks_rota.schema.json",
  "title": "bookmarks_rota",
  "type": "array",
  "minItems": 1,
  "maxItems": 12,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "bookmark_id",
      "title",
      "url",
      "hash",
      "display_week",
      "display_date",
      "taxonomy_category",
      "taxonomy_subcategory",
      "tags"
    ],
    "properties": {
      "bookmark_id": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string"
      },
      "url": {
        "type": "string",
        "pattern": "^https?://"
      },
      "hash": {
        "type": "string",
        "minLength": 1
      },
      "display_week": {
        "type": "string",
        "pattern": "^[0-9]{4}-W[0-9]{2}$"
      },
      "display_date": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "taxonomy_category": {
        "type": "string"
      },
      "taxonomy_subcategory": {
        "type": "string"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "note": {
        "type": "string"
      }
    }
  }
}
